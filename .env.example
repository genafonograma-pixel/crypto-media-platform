GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (free at https://supabase.com)
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# A random secret to protect the /api/process endpoint
# Generate one with: openssl rand -hex 32
PROCESS_SECRET=your-random-secret-here

# AI Thumbnail Generation
# Set to "true" to generate AI thumbnails for every quality article (score ≥ 70).
GENERATE_THUMBNAILS=true

# ImgBB API Key for hosting thumbnails (get free key at https://api.imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Thumbnail provider preference: "pollinations" (free, no key) or "gemini" (higher quality)
# Pollinations is always tried first; Gemini is the automatic fallback if Pollinations fails.
THUMBNAIL_PROVIDER=pollinations
